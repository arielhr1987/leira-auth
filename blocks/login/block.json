{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "leira-auth/login",
	"title": "Leira Auth – Login Form",
	"category": "widgets",
	"icon": "lock",
	"description": "Displays a login form with configurable options.",
	"textdomain": "leira-auth",
	"attributes": {
		"redirect": {
			"type": "string",
			"default": ""
		},
		"form_id": {
			"type": "string",
			"default": ""
		},
		"label_username": {
			"type": "string",
			"default": "Username or Email Address"
		},
		"username_group_class": {
			"type": "string",
			"default": "login-username"
		},
		"username_label_class": {
			"type": "string",
			"default": ""
		},
		"id_username": {
			"type": "string",
			"default": "user_login"
		},
		"username_class": {
			"type": "string",
			"default": "input"
		},
		"username_placeholder": {
			"type": "string",
			"default": ""
		},
		"label_password": {
			"type": "string",
			"default": "Password"
		},
		"password_group_class": {
			"type": "string",
			"default": "login-password"
		},
		"password_label_class": {
			"type": "string",
			"default": ""
		},
		"id_password": {
			"type": "string",
			"default": "user_pass"
		},
		"password_class": {
			"type": "string",
			"default": "input"
		},
		"password_placeholder": {
			"type": "string",
			"default": ""
		},
		"remember": {
			"type": "boolean",
			"default": true
		},
		"value_remember": {
			"type": "boolean",
			"default": false
		},
		"label_remember": {
			"type": "string",
			"default": "Remember Me"
		},
		"id_remember": {
			"type": "string",
			"default": "rememberme"
		},
		"remember_group_class": {
			"type": "string",
			"default": "login-remember"
		},
		"label_log_in": {
			"type": "string",
			"default": "Log In"
		},
		"id_submit": {
			"type": "string",
			"default": "wp-submit"
		},
		"submit_class": {
			"type": "string",
			"default": "button button-primary"
		},
		"submit_group_class": {
			"type": "string",
			"default": "login-submit"
		},
		"show_forgot_password": {
			"type": "boolean",
			"default": true
		},
		"forgot_password_label": {
			"type": "string",
			"default": ""
		},
		"show_register": {
			"type": "boolean",
			"default": true
		},
		"register_label": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "file:../../build/login.js",
	"style": "file:../build/login.css"
}
