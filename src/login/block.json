{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "leira-auth/login",
	"title": "Leira Auth – Login Form",
	"category": "widgets",
	"icon": "lock",
	"description": "Displays a login form with configurable options.",
	"textdomain": "leira-auth",
	"supports": {
		"className": true,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"anchor": true
	},
	"editorScript": "file:./edit.js",
	"style": [
		"wp-block-library",
		"wp-block-buttons",
		"wp-block-button",
		"file:./style.css"
	],
	"editorStyle": [
		"wp-block-library",
		"wp-block-buttons",
		"wp-block-button",
		"file:./editor.css"
	],
	"attributes": {
		"redirect": {
			"type": "string",
			"default": ""
		},
		"username_label": {
			"type": "string",
			"default": "Username or Email Address"
		},
		"username_placeholder": {
			"type": "string",
			"default": ""
		},
		"password_label": {
			"type": "string",
			"default": "Password"
		},
		"password_placeholder": {
			"type": "string",
			"default": ""
		},
		"remember": {
			"type": "boolean",
			"default": true
		},
		"remember_default": {
			"type": "boolean",
			"default": false
		},
		"remember_label": {
			"type": "string",
			"default": "Remember Me"
		},
		"submit_text": {
			"type": "string",
			"default": ""
		},
		"submit_alignment": {
			"type": "string",
			"default": "left"
		},
		"forgot_password_show": {
			"type": "boolean",
			"default": true
		},
		"forgot_password_label": {
			"type": "string",
			"default": ""
		},
		"register_login": {
			"type": "boolean",
			"default": true
		},
		"register_label": {
			"type": "string",
			"default": ""
		}
	}
}
